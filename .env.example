# 🔒 Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!

# ==================== API KEYS ====================

# Google Gemini API
GEMINI_API_KEY=sk_your_gemini_api_key_here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Stability AI (for Stable Diffusion)
# STABILITY_API_KEY=sk-your_stability_key_here

# Replicate (alternative image generation)
# REPLICATE_API_TOKEN=your_replicate_token_here

# Luma Labs (for video generation)
# LUMA_API_KEY=your_luma_key_here

# Runway (alternative video generation)
# RUNWAY_API_KEY=your_runway_key_here

# ==================== DATABASE ====================

# Database Configuration (if using database)
DATABASE_URL=sqlite:///app.db
# For PostgreSQL: postgresql://user:password@localhost:5432/ai_tools

# ==================== SECURITY ====================

# Allowed Origins for CORS
ALLOWED_ORIGINS=localhost:3000,localhost:5000,yourdomain.com

# Flask Secret Key (for sessions)
SECRET_KEY=your-super-secret-key-change-this-in-production

# CSRF Token Settings
CSRF_TOKEN_EXPIRY=3600

# ==================== SERVER ====================

# Flask Environment
FLASK_ENV=development
# FLASK_ENV=production

# Flask Debug Mode (NEVER enable in production)
FLASK_DEBUG=True
# FLASK_DEBUG=False

# Server Port
PORT=5000

# Server Host
HOST=0.0.0.0

# ==================== LOGGING ====================

# Log Level
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG
# LOG_LEVEL=WARNING

# Log File Path
LOG_FILE=logs/app.log

# ==================== RATE LIMITING ====================

# Rate Limits (requests per hour)
RATE_LIMIT_AI_CHAT=100
RATE_LIMIT_IMAGE_GENERATION=20
RATE_LIMIT_CODE_EXECUTION=30
RATE_LIMIT_CODE_ANALYSIS=50

# ==================== SECURITY HEADERS ====================

# Enable Security Headers
ENABLE_SECURITY_HEADERS=True

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' accounts.google.com
CSP_STYLE_SRC='self' 'unsafe-inline'

# ==================== SESSION ====================

# Session Timeout (minutes)
SESSION_TIMEOUT=30

# Session Cookie
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ==================== MONITORING ====================

# Enable Error Tracking
ENABLE_ERROR_TRACKING=True

# Sentry DSN (for error monitoring)
# SENTRY_DSN=https://key@sentry.io/project-id

# ==================== EMAIL (if needed) ====================

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Security Alert Email
SECURITY_ALERT_EMAIL=security@yourdomain.com

# ==================== DEVELOPMENT ====================

# Test Mode
TEST_MODE=False

# Mock API Responses (for testing)
USE_MOCK_RESPONSES=False

# ==================== DOCUMENTATION ====================
# 
# How to set up:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Never commit .env to git
# 4. Add .env to .gitignore (already should be there)
#
# To load environment variables in your code:
# import os
# from dotenv import load_dotenv
# load_dotenv()
#
# api_key = os.environ.get("GEMINI_API_KEY")
